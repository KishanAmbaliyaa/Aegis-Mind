# ==========================================
# Threat Intelligence & AI APIs
# ==========================================
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ==========================================
# Alerting & SOAR Notifications
# ==========================================
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ==========================================
# Webhook Security & Ingestion
# ==========================================
# Secret used for HMAC-SHA256 signature verification (X-Aegis-Signature header)
WEBHOOK_SECRET=your_webhook_hmac_secret_here
REQUIRE_HMAC=false

# ==========================================
# Cache & Database Persistence
# ==========================================
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
DATABASE_URL=sqlite:///aegis_mind.db

# ==========================================
# Server & Rate Limiting
# ==========================================
HOST=0.0.0.0
PORT=5000
DEBUG=false
RATE_LIMIT_DEFAULT=120 per minute
